#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
export AGENT_LLM="${AGENT_LLM:-off}"
case "${1:-}:${2:-}" in
  java:start) exec ./scripts/start.sh ;;
  java:test) exec ./scripts/test.sh ;;
  java:rebuild-index) exec ./scripts/rebuild-index.sh ;;
  *) echo 'Usage: bash scripts/run java {start|test|rebuild-index}. This submission selects Java 17.' >&2; exit 2 ;;
esac
